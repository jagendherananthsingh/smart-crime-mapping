{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "backend/dist/**,backend/.env*,.env*"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|robots\\.txt|api/).*)",
      "destination": "/index.html"
    }
  ]
}
